{
  "name": "aws-private-connectivity-patterns-walkthrough",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Astro + Starlight documentation companion for AWS private cross-account connectivity patterns",
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/check-placeholders.mjs && node scripts/check-asides.mjs && node scripts/check-links.mjs",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/starlight": "^0.41.9",
    "astro": "^7.2.9",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^11.17.2",
    "sharp": "^0.35.4",
    "starlight-base-path": "^0.2.1",
    "starlight-image-zoom": "^0.15.0"
  },
  "devDependencies": {
    "fast-check": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0",
    "markdown-it": "^14.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
